PORT=3000
BASE_URL=https://your-app.onrender.com

# Full Atlas connection string, including the database name, e.g.:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/rizzzler?retryWrites=true&w=majority
# A missing db name, unescaped special characters in the password, or an
# IP not whitelisted in Atlas Network Access will all cause this to fail
# to connect — check the server logs on boot for "MongoDB connected" /
# "Storage cluster ... connected" to confirm it's actually working.
MONGO_URI=your_mongodb_connection_string
SESSION_SECRET=generate_a_long_random_string_here

# ---------- Multi-cluster file storage (requirement #6) ----------
# MONGO_URI is always the primary/coordinator cluster (Users, Settings,
# sessions, and the FileLocation routing table all live here).
# Add more Atlas clusters purely as extra file-storage capacity by
# setting MONGO_URI_2, MONGO_URI_3, ... — nothing else needs to change,
# the storage router (config/storageRouter.js) picks them up automatically.
# Each defaults to a 512MB budget (Atlas free tier); override per-cluster
# with e.g. MONGO_URI_2_CAPACITY_MB=1024 for a bigger paid cluster.
# Optional — leave blank to run on the primary cluster only. Same format
# as MONGO_URI above, pointing at a second (separate) Atlas cluster.
MONGO_URI_2=
# MONGO_URI_2_CAPACITY_MB=512

# ---------- Mail ----------
# Checked in this order, first fully-configured one wins:
#   1) Gmail API (OAuth2)  -- real Google, works on Render's free tier (HTTPS)
#   2) Brevo HTTPS API     -- fallback, also HTTPS-based
#   3) Raw SMTP            -- last resort, works locally, usually BLOCKED
#                              outbound on Render's free tier (SMTP ports
#                              25/465/587 are firewalled there)

# --- Option 1: Gmail API (recommended for Render) ---
# See README "Gmail API setup" for how to obtain these from Google Cloud
# Console + OAuth Playground.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=your_gmail_address@gmail.com

# --- Option 2: Brevo (fallback) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Option 3: Raw SMTP (local dev fallback) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="your_gmail_address@gmail.com"

# ---------- OAuth login (Google / GitHub) ----------
# These are separate from GOOGLE_CLIENT_ID/SECRET above — those are for
# sending mail via the Gmail API; these are for "Continue with Google"
# login. You CAN point both pairs at the same Google Cloud OAuth client if
# you want, but keeping them separate avoids scope/redirect-URI mixups.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application) -> Authorized redirect URI:
#   <BASE_URL>/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback

# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Authorization callback URL:
#   <BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

ADMIN_PASSWORD=Puneet2010@

# ---------- OAuth provider (other apps can "Login with Rizzzler") ----------
# To register OAuth apps, use the admin panel at /admin/oauth-apps
# Apps must provide:
#   - app name and description
#   - redirect URIs (where users are sent after approving)
#   - logo URL (optional)
#   - website URL (optional)
# Each app receives a unique client ID and client secret.
# See OAUTH_PROVIDER.md for developer documentation.

# ---------- AI mail (Mistral) ----------
# Optional — leave blank to just skip AI-generated mail entirely.
# Get a key at https://console.mistral.ai (see README "Mistral AI setup").
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
