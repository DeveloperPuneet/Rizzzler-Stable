<% var pageTitle = "Security — Admin"; var activeNav = "security"; %>
<%- include('partials/header') %>

<div class="rz-admin-topbar">
  <h1>Security</h1>
  <p class="rz-muted">Failed logins, rate limiting, suspicious activity, and IP rules.</p>
</div>

<% if (error) { %><p class="rz-error"><%= error %></p><% } %>
<% if (info) { %><p class="rz-info"><%= info %></p><% } %>

<div class="rz-admin-panel" style="margin-top: 0;">
  <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:center; justify-content:space-between;">
    <div>
      <h2 style="margin:0 0 6px; font-size:1.1rem;">Maintenance</h2>
      <p class="rz-muted" style="margin:0;">Clear stale operational data. All of this is automatically purged after <%= retentionDays %> days.</p>
    </div>
    <div style="display:flex; flex-wrap:wrap; gap:8px;">
      <form action="/admin/security/run-cleanup" method="POST" style="display:inline;">
        <button type="submit" class="rz-btn rz-btn-primary rz-btn-sm">Run cleanup now</button>
      </form>
      <form action="/admin/security/clear-notifications" method="POST" style="display:inline;">
        <button type="submit" class="rz-btn rz-btn-ghost rz-btn-sm">Clear notifications</button>
      </form>
      <form action="/admin/security/clear-visitors" method="POST" style="display:inline;">
        <button type="submit" class="rz-btn rz-btn-ghost rz-btn-sm">Clear visitors</button>
      </form>
      <form action="/admin/security/clear-security-events" method="POST" style="display:inline;">
        <button type="submit" class="rz-btn rz-btn-ghost rz-btn-sm">Clear failed logins</button>
      </form>
      <form action="/admin/security/clear-ip-rules" method="POST" style="display:inline;">
        <button type="submit" class="rz-btn rz-btn-ghost rz-btn-sm">Clear IP rules</button>
      </form>
      <form action="/admin/security/clear-admin-access" method="POST" style="display:inline;">
        <button type="submit" class="rz-btn rz-btn-ghost rz-btn-sm">Clear admin access</button>
      </form>
    </div>
  </div>
</div>

<section class="rz-admin-health-panel" aria-label="System health overview">
  <div class="rz-admin-health-card">
    <span class="rz-admin-health-label">Health status</span>
    <strong class="rz-admin-health-status <%= systemHealth.status === 'healthy' ? 'rz-ok' : (systemHealth.status === 'monitor' ? 'rz-warn' : 'rz-alert') %>"><%= systemHealth.status === 'healthy' ? 'Healthy' : (systemHealth.status === 'monitor' ? 'Monitor' : 'Needs attention') %></strong>
  </div>
  <div class="rz-admin-health-card">
    <span class="rz-admin-health-label">Notifications</span>
    <strong><%= systemHealth.notificationCount %></strong>
  </div>
  <div class="rz-admin-health-card">
    <span class="rz-admin-health-label">Visitor logs</span>
    <strong><%= systemHealth.visitorCount %></strong>
  </div>
  <div class="rz-admin-health-card">
    <span class="rz-admin-health-label">Security events</span>
    <strong><%= systemHealth.securityCount %></strong>
  </div>
  <div class="rz-admin-health-card">
    <span class="rz-admin-health-label">Unverified</span>
    <strong><%= systemHealth.unverifiedUsers %></strong>
  </div>
  <div class="rz-admin-health-card">
    <span class="rz-admin-health-label">Orphaned files</span>
    <strong><%= systemHealth.orphanedFiles %></strong>
  </div>
</section>

<h2 class="rz-admin-section-title">Cleanup log</h2>
<div class="rz-admin-panel rz-admin-panel-scroll">
  <% if (!cleanupLog.length) { %>
    <p class="rz-muted">No cleanup runs logged yet.</p>
  <% } else { %>
    <table class="rz-admin-table">
      <thead><tr><th>Run at</th><th>Status</th><th>Removed</th><th>Summary</th></tr></thead>
      <tbody>
        <% cleanupLog.forEach((entry) => { %>
          <% const summary = entry.summary || {}; %>
          <% const removed = (summary.totalDeleted || 0) + (summary.notifications?.deletedCount || 0) + (summary.visitors?.deletedCount || 0) + (summary.securityEvents?.deletedCount || 0) + (summary.adminAccess?.deletedCount || 0); %>
          <tr>
            <td class="rz-admin-cell-muted"><%= new Date(entry.runAt).toLocaleString() %></td>
            <td><span class="rz-admin-tag <%= entry.status === 'cleanup_ran' ? 'rz-admin-tag-on' : 'rz-admin-tag-muted' %>"><%= entry.status === 'cleanup_ran' ? 'Ran' : 'No action' %></span></td>
            <td><%= removed %></td>
            <td class="rz-admin-cell-muted">
              <% if (summary.notifications && summary.notifications.deletedCount) { %>N:<%= summary.notifications.deletedCount %> <% } %>
              <% if (summary.visitors && summary.visitors.deletedCount) { %>V:<%= summary.visitors.deletedCount %> <% } %>
              <% if (summary.securityEvents && summary.securityEvents.deletedCount) { %>S:<%= summary.securityEvents.deletedCount %> <% } %>
              <% if (summary.adminAccess && summary.adminAccess.deletedCount) { %>A:<%= summary.adminAccess.deletedCount %> <% } %>
              <% if (summary.unverifiedAccounts && summary.unverifiedAccounts.deleted) { %>U:<%= summary.unverifiedAccounts.deleted %> <% } %>
              <% if (summary.orphanedFiles && summary.orphanedFiles.deleted) { %>F:<%= summary.orphanedFiles.deleted %> <% } %>
              <% if (!removed) { %>No stale items found.<% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<section class="rz-admin-stats-grid">
  <div class="rz-admin-stat-card">
    <span class="rz-admin-stat-label">Failed site logins (recent)</span>
    <span class="rz-admin-stat-value"><%= failedLogins.length %></span>
  </div>
  <div class="rz-admin-stat-card">
    <span class="rz-admin-stat-label">Failed admin logins (recent)</span>
    <span class="rz-admin-stat-value"><%= failedAdminLogins.length %></span>
  </div>
  <div class="rz-admin-stat-card">
    <span class="rz-admin-stat-label">Rate-limit blocks (recent)</span>
    <span class="rz-admin-stat-value"><%= rateLimitEvents.length %></span>
  </div>
  <div class="rz-admin-stat-card">
    <span class="rz-admin-stat-label">Suspicious IPs</span>
    <span class="rz-admin-stat-value"><%= suspiciousIps.length %></span>
  </div>
</section>

<h2 class="rz-admin-section-title">Suspicious IP addresses</h2>
<p class="rz-muted">Flagged for sustained high request rates (60+ requests/minute).</p>
<div class="rz-admin-panel rz-admin-panel-scroll">
  <% if (!suspiciousIps.length) { %>
    <p class="rz-muted">Nothing suspicious right now.</p>
  <% } else { %>
    <table class="rz-admin-table">
      <thead><tr><th>IP</th><th>Reason</th><th>Requests</th><th>Last seen</th><th></th></tr></thead>
      <tbody>
        <% suspiciousIps.forEach(v => { %>
          <tr>
            <td class="rz-admin-cell-muted"><%= v.ip %></td>
            <td class="rz-admin-cell-muted"><%= v.suspiciousReason || '—' %></td>
            <td><%= v.totalRequests %></td>
            <td class="rz-admin-cell-muted"><%= new Date(v.lastVisit).toLocaleString() %></td>
            <td>
              <form action="/admin/security/ip-rules" method="POST" style="display:inline">
                <input type="hidden" name="ip" value="<%= v.ip %>" />
                <input type="hidden" name="listType" value="blacklist" />
                <input type="hidden" name="reason" value="Auto-flagged: high request rate" />
                <button type="submit" class="rz-btn rz-btn-ghost rz-btn-sm">Blacklist</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<h2 class="rz-admin-section-title">Blacklist / whitelist management</h2>
<form action="/admin/security/ip-rules" method="POST" class="rz-admin-inline-form">
  <input type="text" name="ip" placeholder="IP address" required />
  <select name="listType">
    <option value="blacklist">Blacklist</option>
    <option value="whitelist">Whitelist</option>
  </select>
  <input type="text" name="reason" placeholder="Reason (optional)" maxlength="300" />
  <button type="submit" class="rz-btn rz-btn-primary">Add rule</button>
</form>

<div class="rz-admin-panel rz-admin-panel-scroll">
  <table class="rz-admin-table">
    <thead><tr><th>IP</th><th>List</th><th>Reason</th><th>Added</th><th></th></tr></thead>
    <tbody>
      <% blacklist.concat(whitelist).forEach(rule => { %>
        <tr>
          <td class="rz-admin-cell-muted"><%= rule.ip %></td>
          <td>
            <span class="rz-admin-tag <%= rule.listType === 'blacklist' ? 'rz-admin-tag-off' : 'rz-admin-tag-on' %>">
              <%= rule.listType %>
            </span>
          </td>
          <td class="rz-admin-cell-muted"><%= rule.reason || '—' %></td>
          <td class="rz-admin-cell-muted"><%= new Date(rule.createdAt).toLocaleDateString() %></td>
          <td>
            <form action="/admin/security/ip-rules/<%= rule._id %>/delete" method="POST" style="display:inline">
              <button type="submit" class="rz-btn rz-btn-ghost rz-btn-sm">Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!blacklist.length && !whitelist.length) { %>
        <tr><td colspan="5" class="rz-muted">No IP rules yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<h2 class="rz-admin-section-title">Failed login attempts</h2>
<div class="rz-admin-panel rz-admin-panel-scroll">
  <table class="rz-admin-table">
    <thead><tr><th>Type</th><th>IP</th><th>Attempted identifier</th><th>When</th></tr></thead>
    <tbody>
      <% failedLogins.concat(failedAdminLogins).sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt)).slice(0, 30).forEach(ev => { %>
        <tr>
          <td><span class="rz-admin-tag rz-admin-tag-muted"><%= ev.type === 'failed_admin_login' ? 'Admin panel' : 'Site login' %></span></td>
          <td class="rz-admin-cell-muted"><%= ev.ip %></td>
          <td class="rz-admin-cell-muted"><%= ev.identifier || '—' %></td>
          <td class="rz-admin-cell-muted"><%= new Date(ev.createdAt).toLocaleString() %></td>
        </tr>
      <% }) %>
      <% if (!failedLogins.length && !failedAdminLogins.length) { %>
        <tr><td colspan="4" class="rz-muted">No failed login attempts recorded.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<h2 class="rz-admin-section-title">Temporary rate limiting</h2>
<p class="rz-muted">
  Global limit: 300 requests / 5 minutes per IP. Auth endpoints: 20 attempts / 15 minutes per IP.
  Whitelisted IPs bypass both. Recent blocks:
</p>
<div class="rz-admin-panel rz-admin-panel-scroll">
  <table class="rz-admin-table">
    <thead><tr><th>IP</th><th>Path</th><th>When</th></tr></thead>
    <tbody>
      <% rateLimitEvents.forEach(ev => { %>
        <tr>
          <td class="rz-admin-cell-muted"><%= ev.ip %></td>
          <td class="rz-admin-cell-muted"><%= ev.path %></td>
          <td class="rz-admin-cell-muted"><%= new Date(ev.createdAt).toLocaleString() %></td>
        </tr>
      <% }) %>
      <% if (!rateLimitEvents.length) { %>
        <tr><td colspan="3" class="rz-muted">No rate-limit blocks recorded.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
