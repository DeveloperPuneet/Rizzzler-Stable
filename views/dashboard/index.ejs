<% pageTitle = "Dashboard — Rizzzler" %>
<%- include('../partials/header') %>

<div class="rz-dash-wrapper">
  <!-- animated background blobs -->
  <div class="rz-dash-blob rz-dash-blob--1"></div>
  <div class="rz-dash-blob rz-dash-blob--2"></div>

  <!-- hero -->
  <section class="rz-dash-hero">
    <div class="rz-dash-hero-content">
      <h1><%= greeting %>, <%= user.displayName || user.username %> 👋</h1>
      <p class="rz-muted">
        <% if (user.isActive === false) { %>
          Your Rizzzler page is currently <strong>paused</strong> — only you can see this preview.
        <% } else { %>
          Your Rizzzler page is live and ready to share.
        <% } %>
      </p>
      <div class="rz-link-box">
        <a href="/<%= user.username %>" target="_blank"><%= baseUrl %>/<%= user.username %></a>
        <% if (user.showLegacyBadge && user.legacyNumber) { %>
          <span class="rz-badge">#<%= user.legacyNumber %></span>
        <% } %>
      </div>
      <div class="rz-dash-hero-actions">
        <a href="/<%= user.username %>" target="_blank" class="rz-btn rz-btn-ghost rz-btn-glow">View my page ↗</a>
        <a href="/dashboard/settings" class="rz-btn rz-btn-primary rz-btn-glow">Customize</a>
      </div>
    </div>
    <!-- mini preview of own page (static mockup) -->
    <div class="rz-dash-preview">
      <div class="rz-dash-preview-card">
        <div class="rz-dash-preview-banner" <% if (user.banner && user.banner.fileId) { %>style="background-image:url('/file/<%= user.banner.fileId %>')"<% } %>></div>
        <div class="rz-dash-preview-avatar">
          <% if (user.avatar && user.avatar.fileId) { %>
            <img src="/file/<%= user.avatar.fileId %>" alt="avatar" />
          <% } else { %>
            <span><%= (user.displayName || user.username).charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
        <div class="rz-dash-preview-name"><%= user.displayName || user.username %></div>
        <div class="rz-dash-preview-bio"><%= user.bio ? user.bio.slice(0, 80) + (user.bio.length > 80 ? '…' : '') : 'Your bio will appear here.' %></div>
        <div class="rz-dash-preview-links">
          <% if (user.links.length > 0) { %>
            <% user.links.slice(0,3).forEach(l => { %><span><%= l.label %></span><% }) %>
          <% } else { %><span>No links yet</span><% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats grid -->
  <section class="rz-dash-grid">
    <div class="rz-card rz-card-glow">
      <h3>Current theme</h3>
      <p><%= themes.find(t => t.key === user.theme)?.label || 'Moonlight' %></p>
      <small class="rz-muted">Switch anytime in settings</small>
    </div>
    <div class="rz-card rz-card-glow">
      <h3>Links</h3>
      <p><%= user.links.length %> added</p>
      <small class="rz-muted">Socials, projects, etc.</small>
    </div>
    <div class="rz-card rz-card-glow">
      <h3>Photos</h3>
      <p><%= user.showcaseImages.length %> / 2</p>
      <small class="rz-muted">Showcase gallery</small>
    </div>
    <div class="rz-card rz-card-glow">
      <h3>Profile views</h3>
      <p><%= user.profileViews || 0 %></p>
      <small class="rz-muted">Since creation</small>
    </div>
  </section>

  <!-- Your stats -->
  <section class="rz-stats-panel" id="rzStatsPanel">
    <div class="rz-stats-header">
      <div>
        <h2>Your stats</h2>
        <p class="rz-muted">How your page has been doing lately — updated in real time.</p>
      </div>
    </div>

    <div class="rz-stats-summary" id="rzStatsSummary">
      <div class="rz-stat-tile">
        <span class="rz-stat-tile-label">Views this week</span>
        <span class="rz-stat-tile-value" id="rzStatWeekly">—</span>
      </div>
      <div class="rz-stat-tile">
        <span class="rz-stat-tile-label">Visitors (30d)</span>
        <span class="rz-stat-tile-value" id="rzStatUnique">—</span>
        <small class="rz-muted">estimated, not tracked individually</small>
      </div>
      <div class="rz-stat-tile">
        <span class="rz-stat-tile-label">Avg. time on page</span>
        <span class="rz-stat-tile-value" id="rzStatAvgTime">—</span>
      </div>
      <div class="rz-stat-tile">
        <span class="rz-stat-tile-label">All-time views</span>
        <span class="rz-stat-tile-value" id="rzStatTotal">—</span>
      </div>
    </div>

    <div class="rz-stats-body">
      <div class="rz-stats-chart-card">
        <h3>Views — last 14 days</h3>
        <div id="rzStatsChart" class="rz-stats-chart">
          <p class="rz-muted">Loading…</p>
        </div>
      </div>

      <div class="rz-stats-side">
        <div class="rz-stats-side-card">
          <h3>Device mix</h3>
          <div id="rzStatsDevices"><p class="rz-muted">Loading…</p></div>
        </div>
        <div class="rz-stats-side-card">
          <h3>Top sources</h3>
          <div id="rzStatsReferrers"><p class="rz-muted">Loading…</p></div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
(function () {
  const currentUserId = '<%= user._id %>';
  const summaryEls = {
    weekly: document.getElementById('rzStatWeekly'),
    unique: document.getElementById('rzStatUnique'),
    avgTime: document.getElementById('rzStatAvgTime'),
    total: document.getElementById('rzStatTotal'),
  };
  const chartEl = document.getElementById('rzStatsChart');
  const devicesEl = document.getElementById('rzStatsDevices');
  const referrersEl = document.getElementById('rzStatsReferrers');

  function formatDuration(seconds) {
    if (!seconds && seconds !== 0) return '—';
    if (seconds < 60) return seconds + 's';
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    return m + 'm ' + s + 's';
  }

  function renderChart(trend) {
    if (!trend || !trend.length) {
      chartEl.innerHTML = '<p class="rz-muted">Not enough data yet.</p>';
      return;
    }

    const w = 640, h = 180;
    const pad = { top: 12, right: 18, bottom: 28, left: 36 };
    const plotW = w - pad.left - pad.right;
    const plotH = h - pad.top - pad.bottom;
    const max = Math.max(1, ...trend.map((d) => d.views));
    const stepX = trend.length > 1 ? plotW / (trend.length - 1) : 0;

    const points = trend.map((d, i) => {
      const x = pad.left + i * stepX;
      const y = h - pad.bottom - (d.views / max) * plotH;
      return { x, y, d, value: d.views };
    });

    const linePath = points
      .map((p, i) => (i === 0 ? 'M' : 'L') + p.x.toFixed(1) + ',' + p.y.toFixed(1))
      .join(' ');
    const areaPath = linePath + ` L${points[points.length - 1].x.toFixed(1)},${h - pad.bottom} L${points[0].x.toFixed(1)},${h - pad.bottom} Z`;

    const yTicks = [0, Math.round(max * 0.25), Math.round(max * 0.5), Math.round(max * 0.75), max];
    const gridLines = yTicks
      .map((tick) => {
        const y = h - pad.bottom - (tick / max) * plotH;
        return `<line x1="${pad.left}" y1="${y.toFixed(1)}" x2="${w - pad.right}" y2="${y.toFixed(1)}" class="rz-stats-grid-line"></line>
                <text x="${pad.left - 8}" y="${(y + 4).toFixed(1)}" text-anchor="end" class="rz-stats-axis-text" style="fill: #dfe3ff; font-size: 10px; font-weight: 700;">${tick}</text>`;
      })
      .join('');

    const xLabels = points
      .map((p, i) => {
        const label = new Date(trend[i].date + 'T00:00:00').toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        return `<text x="${p.x.toFixed(1)}" y="${h - 8}" text-anchor="middle" class="rz-stats-axis-text" style="fill: #dfe3ff; font-size: 10px; font-weight: 700;">${label}</text>`;
      })
      .join('');

    const dots = points
      .map((p, i) => {
        const label = new Date(trend[i].date + 'T00:00:00').toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        return `
          <circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="3.5" class="rz-stats-dot">
            <title>${label}: ${p.d.views} view${p.d.views === 1 ? '' : 's'}</title>
          </circle>
          <text x="${p.x.toFixed(1)}" y="${Math.max(18, p.y - 10).toFixed(1)}" text-anchor="middle" class="rz-stats-value-tag" style="font-size: 9px; font-weight: 800; fill: #f5f7ff;">${p.d.views}</text>
        `;
      })
      .join('');

    chartEl.innerHTML = `
      <div class="rz-stats-chart-shell">
        <svg viewBox="0 0 ${w} ${h}" class="rz-stats-svg" preserveAspectRatio="none">
          <line x1="${pad.left}" y1="${h - pad.bottom}" x2="${w - pad.right}" y2="${h - pad.bottom}" class="rz-stats-axis-line"></line>
          <line x1="${pad.left}" y1="${pad.top}" x2="${pad.left}" y2="${h - pad.bottom}" class="rz-stats-axis-line"></line>
          ${gridLines}
          <path d="${areaPath}" class="rz-stats-area"></path>
          <path d="${linePath}" class="rz-stats-line"></path>
          ${dots}
          ${xLabels}
        </svg>
      </div>
    `;
  }

  function renderDevices(devices) {
    if (!devices || !devices.length) {
      devicesEl.innerHTML = '<p class="rz-muted">Not enough data yet.</p>';
      return;
    }
    const icons = { mobile: '📱', tablet: '📟', desktop: '🖥️' };
    devicesEl.innerHTML = devices
      .map(
        (d) => `
        <div class="rz-stats-bar-row">
          <span class="rz-stats-bar-label">${icons[d.type] || '🖥️'} ${d.type}</span>
          <div class="rz-stats-bar-track"><div class="rz-stats-bar-fill" style="width:${d.pct}%"></div></div>
          <span class="rz-stats-bar-pct">${d.pct}%</span>
        </div>`
      )
      .join('');
  }

  function renderReferrers(referrers) {
    if (!referrers || !referrers.length) {
      referrersEl.innerHTML = '<p class="rz-muted">No external traffic yet — shares go straight to your page.</p>';
      return;
    }
    referrersEl.innerHTML = referrers
      .map((r) => `<div class="rz-stats-ref-row"><span>${r.host}</span><span class="rz-muted">${r.count}</span></div>`)
      .join('');
  }

  function loadStats() {
    return fetch('/dashboard/api/stats')
    .then((r) => r.json())
    .then((data) => {
      if (!data.success) throw new Error('failed');
      const s = data.stats;
      summaryEls.weekly.textContent = s.weeklyViews.toLocaleString();
      summaryEls.unique.textContent = s.uniqueVisitors30d.toLocaleString();
      summaryEls.avgTime.textContent = s.avgSecondsOnPage === null ? 'Not enough data' : formatDuration(s.avgSecondsOnPage);
      summaryEls.total.textContent = s.totalViews.toLocaleString();
      renderChart(s.trend);
      renderDevices(s.devices);
      renderReferrers(s.topReferrers);
    })
    .catch(() => {
      chartEl.innerHTML = '<p class="rz-muted">Couldn\'t load your stats right now.</p>';
      devicesEl.innerHTML = '';
      referrersEl.innerHTML = '';
    });
  }

  loadStats();
  window.addEventListener('rizzzler:user-state', function(event){
    if (event.detail && String(event.detail.userId) === currentUserId && event.detail.payload && event.detail.payload.type === 'stats') loadStats();
  });
})();
</script>

<%- include('../partials/footer') %>
