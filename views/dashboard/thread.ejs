<% pageTitle = "Conversation — Rizzzler" %>
<%- include('../partials/header') %>

<div class="rz-dash-wrapper">
  <section class="rz-dash-hero">
    <div class="rz-dash-hero-content">
      <a href="/dashboard/messages" class="rz-muted" style="text-decoration:underline;">← Back to messages</a>
      <h1 style="margin-top:10px;">Conversation with <%= partner.displayName || partner.username %></h1>
      <% if (typeof sent !== 'undefined' && sent) { %>
        <p class="rz-info" style="margin-top:10px;">Message sent!</p>
      <% } %>
      <% if (typeof msgError !== 'undefined' && msgError) { %>
        <p class="rz-error" style="margin-top:10px;"><%= msgError %></p>
      <% } %>
    </div>
  </section>

  <section class="rz-thread">
    <div class="rz-thread-message <%= String(root.from._id) === String(user._id) ? 'rz-thread-message--mine' : '' %>">
      <div class="rz-thread-message-head">
        <strong>@<%= root.from.username %></strong>
        <span class="rz-muted"><%= new Date(root.createdAt).toLocaleString() %></span>
        <% if (root.coinsPaid) { %>
          <span class="rz-badge"><img src="/images/coins.png" alt="Rizz" class="rz-coin-icon" /> <%= root.coinsPaid %> paid</span>
        <% } %>
      </div>
      <p class="rz-thread-message-body"><%= root.body %></p>
    </div>

    <% if (reply) { %>
      <div class="rz-thread-message <%= String(reply.from._id) === String(user._id) ? 'rz-thread-message--mine' : '' %>">
        <div class="rz-thread-message-head">
          <strong>@<%= reply.from.username %></strong>
          <span class="rz-muted"><%= new Date(reply.createdAt).toLocaleString() %></span>
          <span class="rz-badge">free reply</span>
        </div>
        <p class="rz-thread-message-body"><%= reply.body %></p>
      </div>
    <% } %>

    <% if (canReply) { %>
      <div class="rz-panel rz-panel-glass" style="margin-top:20px;">
        <h3 style="margin-top:0;">Reply — free, one time only</h3>
        <form action="/dashboard/messages/<%= root._id %>/reply" method="POST" class="rz-message-form">
          <textarea name="body" maxlength="1000" rows="3" placeholder="Write your reply…" required></textarea>
          <button type="submit" class="rz-btn rz-btn-primary rz-btn-glow" style="margin-top:10px;">Send reply</button>
        </form>
      </div>
    <% } else if (!reply) { %>
      <p class="rz-muted" style="margin-top:16px;">This thread is closed to free replies. To keep talking, send a new paid message from their profile.</p>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
