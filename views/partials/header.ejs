<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#06060e" />
  <!-- Warm up the analytics connection early without letting it block the
       first paint — the actual gtag script stays async and loads further
       down, after the render-critical stylesheet link. -->
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
  <meta name="description"
    content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : defaultDescription %>" />
  <meta name="keywords"
    content="<%= typeof metaKeywords !== 'undefined' && metaKeywords ? metaKeywords : defaultKeywords %>" />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : siteName %>" />
  <meta property="og:description"
    content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : defaultDescription %>" />
  <meta property="og:image" content="<%= baseUrl %>/images/logo.png" />
  <meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : currentUrl %>" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : siteName %>" />
  <meta name="twitter:description"
    content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : defaultDescription %>" />
  <meta name="twitter:image" content="<%= baseUrl %>/images/logo.png" />
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : currentUrl %>" />
  <title>
    <%= typeof pageTitle !=='undefined' ? pageTitle : 'Rizzzler' %>
  </title>
  <% if (typeof structuredData !=='undefined' && structuredData) { %>
    <script type="application/ld+json"><%- JSON.stringify(structuredData) %></script>
    <% } %>
      <link rel="icon" type="image/png" href="/images/logo.png" />
      <link rel="apple-touch-icon" href="/images/logo.png" />
      <link rel="stylesheet" href="/css/main.css" />
      <% if (typeof extraCss !=='undefined' && extraCss) { %>
        <link rel="stylesheet" href="<%= extraCss %>" />
        <% } %>
          <meta name="monetag" content="6eea333ba778f5a0f0fd630462dfd7b3">
          <meta name='admaven-placement' content=BqTY9qHwF>
          <!-- Loaded after the stylesheet so it never competes with CSS for
               bandwidth on the critical rendering path; still async so it
               doesn't block parsing either way. -->
          <script async src="https://www.googletagmanager.com/gtag/js?id=G-2GM4TWFFR5"></script>
          <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-2GM4TWFFR5');
          </script>
</head>

<body>
  <div class="rz-page-loader" id="pageLoader" aria-hidden="true">
    <div class="rz-loader-card">
      <div class="rz-loader-logo-wrap">
        <img src="/images/logo.png" alt="Rizzzler logo" class="rz-loader-logo" />
      </div>
      <div class="rz-loader-text">Loading your page…</div>
      <div class="rz-loader-bar"><span></span></div>
    </div>
  </div>
  <nav class="rz-nav">
    <a href="/" class="rz-logo">
      <img src="/images/logo.png" alt="Rizzzler logo" class="rz-nav-logo" />
      <span>Rizzzler</span>
    </a>
    <div class="rz-nav-links">
      <a href="/explore">Explore</a>
      <a href="/about-developer">About</a>
      <a href="/privacy-policy">Privacy</a>
      <a href="/terms">Terms</a>
      <% if (isLoggedIn) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/dashboard/settings">Customize</a>
        <a href="/dashboard/messages" class="" title="Your inbox">
          <span class="material-symbols-rounded" aria-hidden="true">mail</span>
        </a>
        <span class="rz-nav-coins" title="Your Rizz balance">
          <img src="/images/coins.png" alt="Rizz" class="rz-coin-icon" style="aspect-ratio:1/1; height:18px;"/>
          <%= ((typeof navUser !== 'undefined' && navUser && navUser.rizz) || 0).toLocaleString() %>
        </span>
        <div class="rz-notif-wrap" id="rzNotifWrap">
          <button type="button" class="rz-notif-bell" id="rzNotifBell" aria-label="Notifications" aria-expanded="false">
            <span class="material-symbols-rounded" aria-hidden="true">notifications</span>
            <% if (typeof navUnreadCount !== 'undefined' && navUnreadCount > 0) { %>
              <span class="rz-notif-badge" id="rzNotifBadge"><%= navUnreadCount > 99 ? '99+' : navUnreadCount %></span>
            <% } %>
          </button>
        </div>
        <a href="/dashboard/settings" class="rz-nav-user" title="Account settings">
          <div class="rz-nav-avatar">
            <% if (typeof navUser !== 'undefined' && navUser && navUser.avatar && navUser.avatar.fileId) { %>
              <img src="/file/<%= navUser.avatar.fileId %>" alt="<%= (navUser.displayName || navUser.username || 'Profile').replace(/"/g, '&quot;') %> avatar" class="rz-nav-avatar-img" />
            <% } else { %>
              <%= (typeof user !=='undefined' && user.displayName) ? user.displayName.charAt(0).toUpperCase() : ((typeof navUser !== 'undefined' && navUser && navUser.displayName) ? navUser.displayName.charAt(0).toUpperCase() : 'U') %>
            <% } %>
          </div>
        </a>
        <% } else { %>
          <a href="/login">Login</a>
          <a href="/register" class="rz-nav-signup">Sign up</a>
          <% } %>
    </div>
  </nav>
  <% if (isLoggedIn) { %>
  <div class="rz-notif-dropdown" id="rzNotifDropdown" hidden>
    <div class="rz-notif-dropdown-header">
      <span>Notifications</span>
      <button type="button" id="rzNotifMarkAll">Mark all read</button>
    </div>
    <div class="rz-notif-list" id="rzNotifList">
      <p class="rz-muted" style="padding:14px;">Loading…</p>
    </div>
  </div>
  <script>
    (function () {
      const bell = document.getElementById('rzNotifBell');
      const dropdown = document.getElementById('rzNotifDropdown');
      const list = document.getElementById('rzNotifList');
      const badge = document.getElementById('rzNotifBadge');
      const markAllBtn = document.getElementById('rzNotifMarkAll');
      if (!bell || !dropdown || !list) return;

      let loaded = false;

      function setDropdownState(open) {
        if (open) {
          dropdown.removeAttribute('hidden');
          bell.setAttribute('aria-expanded', 'true');
        } else {
          dropdown.setAttribute('hidden', '');
          bell.setAttribute('aria-expanded', 'false');
        }
      }

      function isDropdownTarget(target) {
        return !!(target && (dropdown.contains(target) || bell.contains(target)));
      }

      function timeAgo(dateStr) {
        const diff = Math.max(1, Math.round((Date.now() - new Date(dateStr).getTime()) / 1000));
        if (diff < 60) return diff + 's ago';
        if (diff < 3600) return Math.round(diff / 60) + 'm ago';
        if (diff < 86400) return Math.round(diff / 3600) + 'h ago';
        return Math.round(diff / 86400) + 'd ago';
      }

      function render(notifications) {
        if (!notifications.length) {
          list.innerHTML = '<p class="rz-muted" style="padding:14px;">No notifications yet.</p>';
          return;
        }
        list.innerHTML = notifications
          .map(
            (n) => `
            <a href="${n.link || '#'}" class="rz-notif-item ${n.read ? '' : 'rz-notif-item--unread'}" data-id="${n._id}">
              <span class="rz-notif-item-title">${n.title}</span>
              ${n.body ? `<span class="rz-notif-item-body">${n.body}</span>` : ''}
              <span class="rz-notif-item-time">${timeAgo(n.createdAt)}</span>
            </a>`
          )
          .join('');
      }

      function loadNotifications() {
        fetch('/dashboard/api/notifications')
          .then((r) => r.json())
          .then((data) => {
            if (!data.success) return;
            render(data.notifications || []);
            loaded = true;
          })
          .catch(() => {
            list.innerHTML = '<p class="rz-muted" style="padding:14px;">Couldn\'t load notifications.</p>';
          });
      }

      bell.addEventListener('click', (e) => {
        e.stopPropagation();
        const shouldOpen = dropdown.hasAttribute('hidden');
        setDropdownState(shouldOpen);
        if (shouldOpen && !loaded) loadNotifications();
      });

      document.addEventListener('click', (e) => {
        if (!isDropdownTarget(e.target)) {
          setDropdownState(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          setDropdownState(false);
        }
      });

      list.addEventListener('click', (e) => {
        const item = e.target.closest('.rz-notif-item');
        if (!item) return;
        setDropdownState(false);
        fetch('/dashboard/api/notifications/' + item.dataset.id + '/read', { method: 'POST' }).catch(() => {});
      });

      if (markAllBtn) {
        markAllBtn.addEventListener('click', () => {
          fetch('/dashboard/api/notifications/read-all', { method: 'POST' })
            .then(() => {
              if (badge) badge.remove();
              document.querySelectorAll('.rz-notif-item--unread').forEach((el) => el.classList.remove('rz-notif-item--unread'));
            })
            .catch(() => {});
        });
      }
    })();
  </script>
  <% } %>
  <div class="rz-domain-notice" id="rzDomainNotice">
    <p>
      <span class="material-symbols-rounded rz-inline-icon" aria-hidden="true">location_on</span> We've moved! Rizzzler now lives at
      <a href="https://www.rizzzler.work.gd" target="_blank" rel="noopener noreferrer">www.rizzzler.work.gd</a>
      — update your bookmarks.
    </p>
    <button type="button" id="rzDomainNoticeClose" aria-label="Dismiss">
      <span class="material-symbols-rounded" aria-hidden="true">close</span>
    </button>
  </div>
  <script>
    (function () {
      var el = document.getElementById('rzDomainNotice');
      if (!el) return;
      if (localStorage.getItem('rz_domain_notice_dismissed') === '1') {
        el.remove();
        return;
      }
      var closeBtn = document.getElementById('rzDomainNoticeClose');
      if (closeBtn) {
        closeBtn.addEventListener('click', function () {
          localStorage.setItem('rz_domain_notice_dismissed', '1');
          el.remove();
        });
      }
    })();
  </script>
  <main class="rz-main">