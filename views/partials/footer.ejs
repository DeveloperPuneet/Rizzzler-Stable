<script src="/socket.io/socket.io.js"></script>
<script>
(function(){
  if (!window.io) return;
  const socket = window.io({ withCredentials: true });
  window.rizzzlerSocket = socket;
  socket.on('platformStats:update', function(stats){
    window.dispatchEvent(new CustomEvent('rizzzler:platform-stats', { detail: stats }));
  });
  socket.on('userState:update', function(update){
    window.dispatchEvent(new CustomEvent('rizzzler:user-state', { detail: update }));
  });
  socket.on('community:message', function(payload){
    window.dispatchEvent(new CustomEvent('rizzzler:community-message', { detail: payload.message }));
  });
})();
</script>
<script>
