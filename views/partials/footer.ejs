    },
    { label: 'LaunchPadly', href: 'https://launchpadly.co/startup/rizzzler?ref=badge', image:"https://launchpadly.co/embed/badges/startup/rizzzler.svg?variant=listed-on"},
    {
      label: "Startupfa",
      href:"https://startupfa.me/s/rizzzler?utm_source=www.rizzzler.work.gd",
      image: "https://startupfa.me/badges/featured-badge.webp"
    },
    {
      label: 'Stork Verified',
      href: 'https://www.stork.ai/',
      image: 'https://www.stork.ai/badge/verified-dark.svg'
    }
  ];

  const track = document.getElementById('rzFooterMarqueeTrack');
  if (!track || !tagLinks.length) return;

  const items = [...tagLinks, ...tagLinks];
  items.forEach((tag) => {
    const link = document.createElement('a');
    link.href = tag.href || '#';
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.className = 'rz-footer-marquee-item';
    link.setAttribute('aria-label', tag.label || 'Featured link');

    if (tag.image) {
      const img = document.createElement('img');
      img.src = tag.image;
      img.alt = tag.label || 'Featured tag';
      img.loading = 'lazy';
      link.appendChild(img);
    } else {
      link.textContent = tag.label;
    }

    track.appendChild(link);
  });
})();
</script>
<script>
(function(){
  const loader = document.getElementById('pageLoader');
  if (!loader) return;

  const hide = () => {
    if (loader.classList.contains('rz-page-loader--hidden')) return;
    loader.classList.add('rz-page-loader--hidden');
    window.setTimeout(() => loader.remove(), 400);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hide, { once: true });
    window.addEventListener('load', hide, { once: true });
  } else {
    hide();
  }

  window.setTimeout(hide, 1800);
})();
</script>
